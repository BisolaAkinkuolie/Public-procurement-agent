# Copy to .env and fill in ONE of the blocks below.

# --- Local mode with OpenAI -------------------------------------------------------------------
PA_MODE=local
PA_OPENAI_API_KEY=sk-...
PA_CHAT_MODEL=gpt-4o-mini
PA_EMBEDDING_MODEL=text-embedding-3-small

# --- Local mode with Ollama (no API key, fully offline) --------------------------------------
# PA_MODE=local
# PA_OPENAI_BASE_URL=http://localhost:11434/v1
# PA_CHAT_MODEL=qwen2.5:7b-instruct        # any model with tool calling
# PA_EMBEDDING_MODEL=nomic-embed-text

# --- Azure mode (auth via `az login` locally, managed identity in Azure) ---------------------
# PA_MODE=azure
# PA_AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com/
# PA_AZURE_CHAT_DEPLOYMENT=gpt-4o-mini
# PA_AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# PA_AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
# PA_DATABASE_URL=mssql+pyodbc://@<server>.database.windows.net/procurement?driver=ODBC+Driver+18+for+SQL+Server&Authentication=ActiveDirectoryDefault&Encrypt=yes
# APPLICATIONINSIGHTS_CONNECTION_STRING=...

# --- Optional ---------------------------------------------------------------------------------
# PA_MCP_URL=http://localhost:8001/mcp     # use a separately running MCP server
